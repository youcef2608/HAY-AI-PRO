@echo off
:: دعم اللغة العربية في موجه الأوامر
chcp 65001 >nul

echo ===================================================
echo 🚀 جاري تجهيز الملفات للرفع إلى GitHub...
echo ===================================================

:: 1. إضافة كل الملفات (مع تجاهل ما في .gitignore)
git add .

:: 2. طلب رسالة التحديث من المستخدم
set /p commit_msg="📝 اكتب ما الذي قمت بتعديله (أو اضغط Enter للتخطي): "
if "%commit_msg%"=="" set commit_msg="تحديثات جديدة وإصلاحات 🚀"

:: 3. حفظ التغييرات
git commit -m "%commit_msg%"

:: 4. الرفع إلى جيتهاب
echo ⏳ جاري الرفع الآن، يرجى الانتظار...
git push origin main

echo ✅ تم الرفع بنجاح إلى GitHub!
pause